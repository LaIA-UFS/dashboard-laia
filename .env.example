# Token de uma integração do Notion com acesso de leitura às duas bases.
NOTION_TOKEN=
NOTION_MEMBERS_DATA_SOURCE_ID=0b97067d-e5d1-82c3-bd2a-07c4afbb8b3b
NOTION_PROJECTS_DATA_SOURCE_ID=cce7067d-e5d1-83f5-b85f-8747b04b0243

# Acesso administrativo: configure no ambiente privado, sem versionar credenciais.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
APP_URL=http://localhost:3000

# Integração separada: leitura e atualização SOMENTE da base de membros.
# Não habilite inserção nem alteração do esquema. Nunca use NEXT_PUBLIC_*.
NOTION_FORM_TOKEN=
# Opcional; sem este valor, utiliza uma chave derivada de SESSION_SECRET.
# Use ao menos 32 caracteres. Trocar esta chave revoga os links emitidos.
MEMBER_FORM_SECRET=

# Respostas exclusivas do dashboard: curso, disponibilidade e data do envio.
# Conecte um banco Upstash Redis pelo Marketplace do Vercel.
# Quando o Marketplace instalar KV_REST_API_URL e KV_REST_API_TOKEN,
# a aplicação também aceita esse par sem duplicar os valores.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
